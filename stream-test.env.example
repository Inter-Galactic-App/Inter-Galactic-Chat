# Copy this file to .env.stream-test.local before running local stream-lab
# wrappers. The local file is ignored by git.
#
# Keep values machine-local. Do not put secrets in this file.

# Workspace root that contains intergalactic-app/, runtime/, and webrtc-build/.
INTERGALACTIC_WORKSPACE_ROOT=D:\path\to\workspace

# Base stream-lab directory. The app also reads this variable when launched
# from an environment that exports it.
INTERGALACTIC_STREAM_LAB_DIR=${INTERGALACTIC_WORKSPACE_ROOT}\runtime\stream-lab

# Wrapper report output. If omitted, wrappers use
# ${INTERGALACTIC_STREAM_LAB_DIR}\local-results.
INTERGALACTIC_STREAM_LAB_OUTPUT_ROOT=${INTERGALACTIC_STREAM_LAB_DIR}\local-results

# Patched WebRTC build root used as a fallback for libwebrtc.dll discovery.
INTERGALACTIC_WEBRTC_BUILD_ROOT=${INTERGALACTIC_WORKSPACE_ROOT}\webrtc-build

# Optional: where the running Debug app reads stream-test automation requests.
# The default is %APPDATA%\Inter Galactic\Inter Galactic\logs\stream-tests.
# INTERGALACTIC_STREAM_TEST_APP_DIR=%APPDATA%\Inter Galactic\Inter Galactic\logs\stream-tests

# Optional: call room the synthetic live-call wrapper should join via the
# app's single-instance stream_lab_open_room IPC message. When set, the
# wrapper joins deterministically over the pipe instead of sending the
# Ctrl+Alt+PgDown call hotkey with SendKeys, whose ~1 ms key taps the app's
# 35 ms shortcut poller usually misses (BUG-275). Use the room id/alias the
# call hotkey points at; the client id is only needed with multiple accounts.
# INTERGALACTIC_STREAM_LAB_CALL_ROOM_ADDRESS=!yourCallRoomId
# INTERGALACTIC_STREAM_LAB_CALL_ROOM_CLIENT_ID=yourClientId

# Optional: override binary discovery when your build outputs live elsewhere.
# INTERGALACTIC_LIBWEBRTC_DLL=${INTERGALACTIC_WEBRTC_BUILD_ROOT}\src\out\Default\libwebrtc.dll
# INTERGALACTIC_GAME_CAPTURE_HELPER_PATH=${INTERGALACTIC_WORKSPACE_ROOT}\intergalactic-app\inter-galactic\plugins\intergalactic_game_capture\windows\build\Debug\intergalactic_game_capture_helper.exe
# INTERGALACTIC_GAME_CAPTURE_TARGET_PATH=${INTERGALACTIC_WORKSPACE_ROOT}\intergalactic-app\inter-galactic\tools\game-capture-target\build\Debug\InterGalacticCaptureTarget.exe
